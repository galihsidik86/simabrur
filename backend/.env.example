# Salin ke .env dan sesuaikan.
# PRODUKSI: NODE_ENV=production menolak start bila JWT secret masih default/pendek (<32 char).
#   Buat secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# CORS_ORIGIN hanya perlu diisi bila frontend disajikan dari origin berbeda.
NODE_ENV=development
PORT=3001

DATABASE_URL=postgres://safar:safar_dev@localhost:5434/safar
DATABASE_URL_TEST=postgres://safar:safar_dev@localhost:5434/safar_test

JWT_ACCESS_SECRET=ganti-dengan-secret-acak-panjang
JWT_REFRESH_SECRET=ganti-dengan-secret-acak-lainnya
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
